{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "NullableString": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "properties": {
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "PostToolUse",
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "permission_mode": {
      "enum": [
        "default",
        "acceptEdits",
        "plan",
        "dontAsk",
        "bypassPermissions"
      ],
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "tool_input": {
      "description": "Dynamic tool input. Shape depends on `tool_name`: - Bash: `{ \"command\": \"<shell command>\" }` - apply_patch: `{ \"files\": [\"path/a.rs\", \"path/b.rs\"] }`"
    },
    "tool_name": {
      "enum": [
        "Bash",
        "apply_patch"
      ],
      "type": "string"
    },
    "tool_response": true,
    "tool_use_id": {
      "type": "string"
    },
    "transcript_path": {
      "$ref": "#/definitions/NullableString"
    },
    "turn_id": {
      "description": "Codex extension: expose the active turn id to internal turn-scoped hooks.",
